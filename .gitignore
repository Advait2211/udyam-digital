# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# app database (synthetic demo data, recreated on start)
/data/app.db*
# deck tooling
/docs/deck/node_modules
!.env.example

# demo video tooling (re-record with docs/video/record.mjs)
/docs/video/node_modules
/docs/video/frames
/docs/video/*.mp4
/docs/video/failure.png
