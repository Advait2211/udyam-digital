# Copy to .env.local. Everything works without keys (rule-based understanding,
# template explanations, on-device OCR, browser speech). Keys only add AI polish.

# NVIDIA NIM — https://build.nvidia.com (English chat + document vision)
NVIDIA_API_KEY=
# NIM_CHAT_MODEL=deepseek-ai/deepseek-v4.1-flash
# NIM_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Sarvam — https://dashboard.sarvam.ai (Hindi/Marathi replies, speech-to-text, text-to-speech)
SARVAM_API_KEY=
# SARVAM_CHAT_MODEL=sarvam-m
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_TTS_MODEL=bulbul:v2
